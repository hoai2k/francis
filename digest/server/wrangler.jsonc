{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "francis-digest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Workers AI, for the short recaps written on request (POST /recap).
  "ai": { "binding": "AI" },
  // Where digests are kept. The deploy workflow fills in the id (it creates
  // the namespace "francis-digest" the first time); for a manual deploy, run
  // `npx wrangler kv namespace create francis-digest` and paste the id here.
  "kv_namespaces": [{ "binding": "DIGEST", "id": "KV_NAMESPACE_ID" }],
  // No schedule: the first visit of a day builds that day's digest. The empty
  // list also removes the daily trigger earlier versions had.
  "triggers": { "crons": [] }
}
